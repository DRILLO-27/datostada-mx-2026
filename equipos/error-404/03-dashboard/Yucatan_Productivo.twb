      <column caption="Precipitación anual (mm)" datatype="real" name="[Rain]" role="measure" type="quantitative">
        <calculation class="tableau" formula="CASE [anio] WHEN 2016 THEN 885.2 WHEN 2017 THEN 1120.5 WHEN 2018 THEN 998.7 WHEN 2019 THEN 1034.2 WHEN 2020 THEN 1802.2 WHEN 2021 THEN 1172.6 WHEN 2022 THEN 1154.7 WHEN 2023 THEN 911.3 WHEN 2024 THEN 1477.2 WHEN 2025 THEN 972.3 END" />
      </column>
      <column caption="Siniestralidad (%)" datatype="real" name="[Loss]" role="measure" type="quantitative" default-format="p0.0%">
        <calculation class="tableau" formula="SUM([siniestrada_ha])/SUM([sembrada_ha])" />
      </column>
      <column caption="Valor (millones de pesos)" datatype="real" name="[ValueM]" role="measure" type="quantitative" default-format="n#,##0.0">
        <calculation class="tableau" formula="SUM([valor_produccion_pesos])/1000000" />
      </column>
      <column caption="Superficie de riego · 2025" datatype="real" name="[Share]" role="measure" type="quantitative" default-format="p0.0%">
        <calculation class="tableau" formula="SUM(IF [anio]=2025 AND [modalidad]=&quot;Riego&quot; THEN [sembrada_ha] ELSE 0 END)/SUM(IF [anio]=2025 THEN [sembrada_ha] ELSE 0 END)" />
      </column>
      <column caption="Riego / temporal · 2016–2025" datatype="real" name="[YieldRatio]" role="measure" type="quantitative" default-format="n0.0&quot;x&quot;">
        <calculation class="tableau" formula="(SUM(IF [modalidad]=&quot;Riego&quot; THEN [volumen_produccion] END)/SUM(IF [modalidad]=&quot;Riego&quot; THEN [cosechada_ha] END))/(SUM(IF [modalidad]=&quot;Temporal&quot; THEN [volumen_produccion] END)/SUM(IF [modalidad]=&quot;Temporal&quot; THEN [cosechada_ha] END))" />
      </column>
      <column caption="Pérdida anual" datatype="real" name="[AnnualLoss]" role="measure" type="quantitative" default-format="p0.0%">
        <calculation class="tableau" formula="{ FIXED [anio] : SUM([siniestrada_ha])/SUM([sembrada_ha]) }" />
      </column>
      <column caption="Pérdida máxima anual · 2016–2025" datatype="real" name="[MaxLoss]" role="measure" type="quantitative" default-format="p0.0%">
        <calculation class="tableau" formula="MAX([AnnualLoss])" />
      </column>
      <column caption="Valor 2025 · millones de pesos" datatype="real" name="[Value2025]" role="measure" type="quantitative" default-format="n#,##0.0">
        <calculation class="tableau" formula="SUM(IF [anio]=2025 THEN [valor_produccion_pesos] END)/1000000" />
      </column>
      <column caption="Selección" datatype="boolean" name="[Include]" role="dimension" type="nominal">
